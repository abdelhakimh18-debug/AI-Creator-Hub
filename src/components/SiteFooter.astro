---
const navLinks = [
  { href: '/tools/', label: 'Tools' },
  { href: '/compare/', label: 'Compare' },
  { href: '/best/', label: 'Best' },
  { href: '/guides/', label: 'Guides' },
  { href: '/prompts/', label: 'Prompts' },
  { href: '/tool-finder/', label: 'Tool Finder' },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-surface mt-7">
  <div class="max-w-5xl mx-auto px-3 py-6">
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-small mb-4">
      {navLinks.map((link) => (
        <a href={link.href} class="text-text2 hover:text-text hover:underline">{link.label}</a>
      ))}
    </nav>
    <p class="text-small text-text2">© {year} Creatoria Hub. AI tools for creators — pricing and features are verified where possible and clearly labeled when compiled from third-party sources.</p>
  </div>
</footer>
