---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection('bestOf');
const hasDemo = entries.some((e) => e.data.isDemo);
---
<Layout
  title="Best AI Tools — Curated Lists"
  description="Curated best-of lists of AI tools for creators, organized by use case."
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Best-Of', item: new URL('/best/', Astro.site).toString() },
    ],
  }}
>
  <main class="max-w-3xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <span>Best-Of</span>
    </nav>
    <h1 class="text-h1 mb-4">Best AI Tools — Curated Lists</h1>
    <p class="text-body text-text2 mb-4">Curated lists of AI tools for creators, grouped by use case. Order within each list is based on verified specifications, not a fabricated quality ranking — see each list for details.</p>
    <div class="flex flex-col gap-2">
      {entries.map((e) => (
        <a href={`/best/${e.slug}/`} class="border border-border rounded-card bg-surface p-3 block hover:shadow-md transition-shadow">
          {e.data.title}
        </a>
      ))}
    </div>
  </main>
</Layout>
