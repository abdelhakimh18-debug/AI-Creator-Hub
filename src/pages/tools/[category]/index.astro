---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ToolCard from '../../../components/ToolCard.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const categories = [...new Set(tools.map((t) => t.data.category))];
  return categories.map((category) => ({
    params: { category },
    props: { tools: tools.filter((t) => t.data.category === category) },
  }));
}

const { tools } = Astro.props;
const { category } = Astro.params;
const hasDemo = tools.some((t) => t.data.isDemo);
---
<Layout
  title={`Best ${category} AI Tools`}
  description={`Compare the best AI ${category} tools for creators — pricing, free plans, and features, side by side.`}
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: category, item: new URL(`/tools/${category}/`, Astro.site).toString() },
    ],
  }}
>
  <main class="max-w-5xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <a href="/tools/">Tools</a> / <span class="capitalize">{category}</span>
    </nav>
    <h1 class="text-h1 capitalize mb-4">{category} AI Tools</h1>
    <p class="text-body text-text2 mb-4">{tools.length} {category} tool{tools.length !== 1 ? 's' : ''} — compare pricing, free plans, and features side by side.</p>
    <div class="grid grid-cols-1 tablet:grid-cols-2 desktop:grid-cols-4 gap-3">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </main>
</Layout>
