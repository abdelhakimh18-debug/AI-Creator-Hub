---
import { getCollection, getEntry } from 'astro:content';
import { getOverallRating } from '../../../lib/rating';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { category: tool.data.category, slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await tool.render();
const d = tool.data;
const rating = getOverallRating(d.subScores);
const hasTesting = d.ourTestPrompts.length > 0;
const alternatives = await Promise.all((d.alternatives ?? []).map((ref) => getEntry(ref)));

// Related content: pulled live from the data model, not hardcoded
const allComparisons = await getCollection('comparisons');
const relatedComparisons = await Promise.all(
  allComparisons
    .filter((c) => c.data.toolA.id === tool.id || c.data.toolB.id === tool.id)
    .map(async (c) => ({
      slug: c.slug,
      toolA: await getEntry(c.data.toolA),
      toolB: await getEntry(c.data.toolB),
    }))
);

const allBestOf = await getCollection('bestOf');
const relatedBestOf = allBestOf.filter((b) =>
  b.data.includedTools.some((item) => item.tool.id === tool.id)
);
---
<Layout title={`${d.toolName} — AI Tool Profile`} noindex={d.isDemo}>
  {d.isDemo && (
    <div class="bg-demo text-white text-center py-1 text-small">DEMO DATA — for prototype testing only</div>
  )}

  <main class="max-w-3xl mx-auto px-3 py-5">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <a href="/tools/">Tools</a> / <a href={`/tools/${d.category}/`} class="capitalize">{d.category}</a> / <span>{d.toolName}</span>
    </nav>

    <p class="text-small text-text2 uppercase">{d.category}</p>
    <h1 class="text-h1">{d.toolName}</h1>
    <p class="text-body text-text2 mt-1">{d.shortDescription}</p>

    <div class="bg-surface border border-border rounded-card p-3 mt-4">
      <p class="text-small text-text2 uppercase mb-1">Quick Verdict</p>
      <p class="text-body">{d.quickVerdict}</p>
      <p class="text-small text-text2 mt-2">Data last verified: {d.lastTestedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </div>

    <div class="flex gap-4 my-4 items-center">
      <span class="font-semibold text-h3">
        {rating !== null ? `${rating}/10` : 'Rating: Pending'}
      </span>
      <span>{d.hasFreePlan ? 'Free plan available' : `From $${d.startingPrice}/mo`}</span>
    </div>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Pricing</h2>
      {d.pricingTiers.length > 0 ? (
        <div class="flex flex-col gap-2">
          {d.pricingTiers.map((tier) => (
            <div class="border border-border rounded-card p-2">
              <p class="font-semibold">{tier.tierName} — {tier.price === 0 ? 'Free' : `$${tier.price}/${tier.billingPeriod}`}</p>
              {tier.features && <p class="text-small text-text2">{tier.features}</p>}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-body text-text2">Pricing details pending verification.</p>
      )}
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Free Plan / Trial</h2>
      <p class="text-body">
        {d.hasFreePlan && 'This tool offers a permanent free plan.'}
        {!d.hasFreePlan && d.hasFreeTrial && 'This tool offers a free trial (no permanent free plan).'}
        {!d.hasFreePlan && !d.hasFreeTrial && 'No free plan or trial is currently offered.'}
      </p>
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Key Features</h2>
      <ul class="list-disc pl-5">
        {d.features.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Best For</h2>
      <ul class="list-disc pl-5">
        {d.bestFor.map((b) => <li>{b}</li>)}
      </ul>
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Commercial Use & Watermark</h2>
      <p class="text-body">Commercial use: {d.commercialUse ? 'Available (see note)' : 'Not available / restricted'}</p>
      {d.commercialUseNote && <p class="text-small text-text2 mt-1">{d.commercialUseNote}</p>}
      <p class="text-body mt-2">Watermark on free/base output: {d.watermark ? 'Yes' : 'No'}</p>
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Pros & Cons</h2>
      {(d.pros.length > 0 || d.cons.length > 0) ? (
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="font-semibold mb-1">Pros</p>
            <ul class="list-disc pl-4">{d.pros.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div>
            <p class="font-semibold mb-1">Cons</p>
            <ul class="list-disc pl-4">{d.cons.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      ) : (
        <p class="text-body text-text2">Pending — genuine pros/cons will be added after hands-on testing.</p>
      )}
    </section>

    <section class="my-5 border border-border rounded-card p-3 bg-surface">
      <h2 class="text-h3 mb-2">Our Testing</h2>
      {hasTesting ? (
        <div class="flex flex-col gap-3">
          {d.ourTestPrompts.map((t) => (
            <div>
              <p class="font-semibold text-small">Prompt:</p>
              <p class="text-body">{t.promptText}</p>
              {t.notes && <p class="text-small text-text2 mt-1">{t.notes}</p>}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-body text-text2">Testing in progress — this profile is based on officially verified information. Hands-on test results will be added once testing is complete.</p>
      )}
    </section>

    <section class="my-5">
      <h2 class="text-h3 mb-2">Alternatives</h2>
      {alternatives.length > 0 ? (
        <ul class="list-disc pl-5">
          {alternatives.map((alt) => (
            <li><a href={`/tools/${alt.data.category}/${alt.slug}/`} class="text-accent">{alt.data.toolName}</a></li>
          ))}
        </ul>
      ) : (
        <p class="text-body text-text2">No alternatives linked yet.</p>
      )}
    </section>

    <!-- Related content: now data-driven, pulled from comparisons/bestOf collections -->
    <section class="my-5">
      <h2 class="text-h3 mb-2">Related Content</h2>
      {(relatedComparisons.length > 0 || relatedBestOf.length > 0) ? (
        <ul class="list-disc pl-5">
          {relatedComparisons.map((c) => (
            <li><a href={`/compare/${c.slug}/`} class="text-accent">{c.toolA.data.toolName} vs {c.toolB.data.toolName}</a></li>
          ))}
          {relatedBestOf.map((b) => (
            <li><a href={`/best/${b.slug}/`} class="text-accent">{b.data.title}</a></li>
          ))}
        </ul>
      ) : (
        <p class="text-body text-text2">Related guides and comparisons will appear here once published.</p>
      )}
    </section>

    {d.faq.length > 0 && (
      <section class="my-5">
        <h2 class="text-h3 mb-2">FAQ</h2>
        <div class="flex flex-col gap-3">
          {d.faq.map((item) => (
            <div>
              <p class="font-semibold">{item.question}</p>
              <p class="text-body text-text2">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="prose max-w-none my-5"><Content /></section>

    {d.affiliateUrl && (
      <p class="text-small text-text2 mb-2">This page may contain an affiliate link. We may earn a commission at no extra cost to you.</p>
    )}

    <a href={d.affiliateUrl ?? d.websiteUrl} rel="nofollow sponsored" class="inline-block bg-accent text-white rounded-btn px-4 py-2">
      Visit Official Website ↗
    </a>
  </main>
</Layout>
