---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';

const tools = await getCollection('tools');
const hasDemo = tools.some((t) => t.data.isDemo);
const categories = [...new Set(tools.map((t) => t.data.category))].sort();
const categoryLabel = (c: string) => (c === 'ugc' ? 'UGC' : c.charAt(0).toUpperCase() + c.slice(1));
---
<Layout
  title="Find My Tool"
  description="Answer two quick questions to see which AI tools match what you want to create and your budget."
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Find My Tool', item: new URL('/tool-finder/', Astro.site).toString() },
    ],
  }}
>
  <main class="max-w-5xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <span>Find My Tool</span>
    </nav>
    <h1 class="text-h1 mb-2">Find My Tool</h1>
    <p class="text-body text-text2 mb-6">
      A simple first pass — filter by what you want to create and your budget. This will grow into a fuller
      recommendation flow as the tool database expands.
    </p>

    <div class="flex flex-wrap gap-6 items-end mb-6 p-4 border border-border rounded-card bg-surface">
      <div>
        <label for="category-filter" class="block text-small font-semibold mb-1">What do you want to create?</label>
        <select id="category-filter" class="border border-border rounded px-2 py-1.5 bg-background">
          <option value="all">All categories</option>
          {categories.map((c) => <option value={c}>{categoryLabel(c)}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" id="free-filter" class="w-4 h-4" />
        <label for="free-filter" class="text-body">Free plan only</label>
      </div>
    </div>

    <p id="result-count" class="text-small text-text2 mb-3"></p>

    <div id="results" class="grid grid-cols-1 tablet:grid-cols-2 desktop:grid-cols-3 gap-3">
      {tools.map((tool) => (
        <div class="tool-finder-item" data-category={tool.data.category} data-free={tool.data.hasFreePlan ? '1' : '0'}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <p id="empty-state" class="text-body text-text2" hidden>No tools match these filters yet — try widening your criteria.</p>
  </main>

  <script>
    const categorySelect = document.getElementById('category-filter') as HTMLSelectElement;
    const freeCheckbox = document.getElementById('free-filter') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('.tool-finder-item');
    const resultCount = document.getElementById('result-count')!;
    const emptyState = document.getElementById('empty-state')!;

    function applyFilters() {
      const category = categorySelect.value;
      const freeOnly = freeCheckbox.checked;
      let visible = 0;
      items.forEach((item) => {
        const matchesCategory = category === 'all' || item.dataset.category === category;
        const matchesFree = !freeOnly || item.dataset.free === '1';
        const show = matchesCategory && matchesFree;
        item.hidden = !show;
        if (show) visible++;
      });
      resultCount.textContent = `${visible} tool${visible !== 1 ? 's' : ''} match`;
      emptyState.hidden = visible !== 0;
    }

    categorySelect.addEventListener('change', applyFilters);
    freeCheckbox.addEventListener('change', applyFilters);
    applyFilters();
  </script>
</Layout>
