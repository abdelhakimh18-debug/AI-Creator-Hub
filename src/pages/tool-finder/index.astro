---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';

const tools = await getCollection('tools');
const hasDemo = tools.some((t) => t.data.isDemo);
const categories = [...new Set(tools.map((t) => t.data.category))].sort();
const categoryLabel = (c: string) => (c === 'ugc' ? 'UGC' : c.charAt(0).toUpperCase() + c.slice(1));

// Search text pulled straight from real fields — bestFor is the richest use-case data we have per tool.
const searchText = (t: (typeof tools)[number]) =>
  [t.data.toolName, ...t.data.bestFor, t.data.shortDescription].join(' ').toLowerCase();
---
<Layout
  title="Find My Tool"
  description="Filter AI tools by what you want to create, your budget, and free-plan availability."
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Find My Tool', item: new URL('/tool-finder/', Astro.site).toString() },
    ],
  }}
>
  <main class="max-w-5xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <span>Find My Tool</span>
    </nav>
    <h1 class="text-h1 mb-2">Find My Tool</h1>
    <p class="text-body text-text2 mb-6">
      Filter by what you want to create, your budget, and free-plan availability. This will grow into a fuller
      recommendation flow as the tool database expands.
    </p>

    <div class="flex flex-col gap-4 mb-6 p-4 border border-border rounded-card bg-surface">
      <div>
        <label for="search-filter" class="block text-small font-semibold mb-1">What do you want to make?</label>
        <input
          type="text"
          id="search-filter"
          placeholder="e.g. YouTube, podcast, filmmaker, marketing…"
          class="w-full border border-border rounded px-2 py-1.5 bg-background"
        />
      </div>
      <div class="flex flex-wrap gap-6 items-end">
        <div>
          <label for="category-filter" class="block text-small font-semibold mb-1">Category</label>
          <select id="category-filter" class="border border-border rounded px-2 py-1.5 bg-background">
            <option value="all">All categories</option>
            {categories.map((c) => <option value={c}>{categoryLabel(c)}</option>)}
          </select>
        </div>
        <div>
          <label for="budget-filter" class="block text-small font-semibold mb-1">Max budget</label>
          <select id="budget-filter" class="border border-border rounded px-2 py-1.5 bg-background">
            <option value="any">Any budget</option>
            <option value="10">$10/mo or less</option>
            <option value="20">$20/mo or less</option>
            <option value="30">$30/mo or less</option>
          </select>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="free-filter" class="w-4 h-4" />
          <label for="free-filter" class="text-body">Free plan only</label>
        </div>
      </div>
    </div>

    <p id="result-count" class="text-small text-text2 mb-3"></p>

    <div id="results" class="grid grid-cols-1 tablet:grid-cols-2 desktop:grid-cols-3 gap-3">
      {tools.map((tool) => (
        <div
          class="tool-finder-item"
          data-category={tool.data.category}
          data-free={tool.data.hasFreePlan ? '1' : '0'}
          data-price={tool.data.startingPrice}
          data-search={searchText(tool)}
        >
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <p id="empty-state" class="text-body text-text2" hidden>No tools match these filters yet — try widening your criteria.</p>
  </main>

  <script>
    const searchInput = document.getElementById('search-filter') as HTMLInputElement;
    const categorySelect = document.getElementById('category-filter') as HTMLSelectElement;
    const budgetSelect = document.getElementById('budget-filter') as HTMLSelectElement;
    const freeCheckbox = document.getElementById('free-filter') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('.tool-finder-item');
    const resultCount = document.getElementById('result-count')!;
    const emptyState = document.getElementById('empty-state')!;

    function applyFilters() {
      const query = searchInput.value.trim().toLowerCase();
      const category = categorySelect.value;
      const maxBudget = budgetSelect.value;
      const freeOnly = freeCheckbox.checked;
      let visible = 0;
      items.forEach((item) => {
        const isFree = item.dataset.free === '1';
        const matchesSearch = !query || (item.dataset.search ?? '').includes(query);
        const matchesCategory = category === 'all' || item.dataset.category === category;
        const matchesFree = !freeOnly || isFree;
        // A free plan satisfies any budget cap — the paid price only matters if there's no free tier.
        const matchesBudget = maxBudget === 'any' || isFree || Number(item.dataset.price) <= Number(maxBudget);
        const show = matchesSearch && matchesCategory && matchesFree && matchesBudget;
        item.hidden = !show;
        if (show) visible++;
      });
      resultCount.textContent = `${visible} tool${visible !== 1 ? 's' : ''} match`;
      emptyState.hidden = visible !== 0;
    }

    searchInput.addEventListener('input', applyFilters);
    categorySelect.addEventListener('change', applyFilters);
    budgetSelect.addEventListener('change', applyFilters);
    freeCheckbox.addEventListener('change', applyFilters);
    applyFilters();
  </script>
</Layout>
