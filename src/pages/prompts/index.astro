---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../lib/slugify';

const prompts = await getCollection('prompts');
const hasDemo = prompts.some((p) => p.data.isDemo);
const categories = [...new Set(prompts.map((p) => p.data.category))];
---
<Layout
  title="AI Prompt Library"
  description="Ready-to-adapt AI prompts for video, cinematic, advertising, YouTube, and social content workflows."
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Prompt Library', item: new URL('/prompts/', Astro.site).toString() },
    ],
  }}
>
  <main class="max-w-3xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4"><a href="/">Home</a> / <span>Prompt Library</span></nav>
    <h1 class="text-h1 mb-2">AI Prompt Library</h1>
    <p class="text-body text-text2 mb-6">Ready-to-adapt prompts for video, cinematic, advertising, YouTube, and social content workflows.</p>
    <div class="flex flex-wrap gap-2 mb-6">
      {categories.map((category) => (
        <a href={`/prompts/category/${slugify(category)}/`} class="text-small border border-border rounded px-2 py-1 hover:bg-surface">{category}</a>
      ))}
    </div>
    <div class="flex flex-col gap-3">
      {prompts.map((prompt) => (
        <a href={`/prompts/${prompt.slug}/`} class="border border-border rounded-card bg-surface p-4 block hover:shadow-md transition-shadow">
          <p class="text-small text-text2 uppercase mb-1">{prompt.data.category}</p>
          <h2 class="text-h3">{prompt.data.title ?? prompt.data.promptText.slice(0, 110) + (prompt.data.promptText.length > 110 ? '…' : '')}</h2>
        </a>
      ))}
    </div>
  </main>
</Layout>
