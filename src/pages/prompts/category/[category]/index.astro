---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import { slugify } from '../../../../lib/slugify';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  const categories = [...new Set(prompts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, prompts: prompts.filter((p) => p.data.category === category) },
  }));
}

const { category, prompts } = Astro.props;
const hasDemo = prompts.some((p) => p.data.isDemo);
const categoryUrl = new URL(`/prompts/category/${slugify(category)}/`, Astro.site).toString();
---
<Layout
  title={category}
  description={`Free, ready-to-use ${category} for AI generation tools — copy, customize, and use directly.`}
  noindex={hasDemo}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Prompt Library', item: new URL('/prompts/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: category, item: categoryUrl },
    ],
  }}
>
  <main class="max-w-3xl mx-auto px-3 py-6">
    <nav class="text-small text-text2 mb-4">
      <a href="/">Home</a> / <a href="/prompts/">Prompt Library</a> / <span>{category}</span>
    </nav>
    <h1 class="text-h1 mb-2">{category}</h1>
    <p class="text-body text-text2 mb-6">Free, ready-to-use prompts — copy, customize, and use directly with your favorite AI tool.</p>
    <div class="flex flex-col gap-3">
      {prompts.map((prompt) => (
        <a href={`/prompts/${prompt.slug}/`} class="border border-border rounded-card bg-surface p-4 block hover:shadow-md transition-shadow">
          <h2 class="text-h3">{prompt.data.title ?? prompt.data.promptText.slice(0, 110) + (prompt.data.promptText.length > 110 ? '…' : '')}</h2>
        </a>
      ))}
    </div>
  </main>
</Layout>
